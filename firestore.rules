rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Hjälpfunktioner ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath());
    }

    function role() {
      return hasProfile() ? get(userPath()).data.get('role', null) : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isManager() {
      return role() == 'manager';
    }

    function isCustomer() {
      return role() == 'customer';
    }

    function isCashier() {
      return role() == 'cashier';
    }

    function isPartner() {
      return role() == 'partner';
    }

    function myOfficeId() {
      return hasProfile() ? get(userPath()).data.get('officeId', null) : null;
    }

    function metaCustomersPath() {
      return /databases/$(database)/documents/meta/customers;
    }

    function lastClientIdBefore() {
      return exists(metaCustomersPath())
        ? get(metaCustomersPath()).data.get('lastClientId', 0)
        : 0;
    }

    function metaTransactionsPath() {
      return /databases/$(database)/documents/meta/transactions;
    }

    function lastTransactionNoBefore() {
      return exists(metaTransactionsPath())
        ? get(metaTransactionsPath()).data.get('lastTransactionNo', 0)
        : 0;
    }

    // Ny transaktion får nästa löpnummer: räknaren i meta/transactions ökas
    // med exakt 1 i samma skrivning och numret är räknarens nya värde.
    function hasNextTransactionNo() {
      return request.resource.data.transactionNo is int
        && getAfter(metaTransactionsPath()).data.lastTransactionNo == lastTransactionNoBefore() + 1
        && request.resource.data.transactionNo == getAfter(metaTransactionsPath()).data.lastTransactionNo;
    }

    // Numret är valfritt (äldre appversioner skickar inget, och admin numrerar
    // dem i efterhand), men finns det måste det vara nästa lediga nummer.
    function hasValidTransactionNo() {
      return !('transactionNo' in request.resource.data) || hasNextTransactionNo();
    }

    // ─── KUNDNIVÅER ────────────────────────────────────────────────
    // Admin ger kunden en nivå (tier) i customers/{uid} och kan ge en egen
    // rabatt (tierDiscount) i stället för nivåns. Rabatten är procentenheter
    // som dras från avgiften managern skriver. Rabatten per nivå ligger i
    // meta/tiers; samma standardvärden som i appen
    // (lib/utils/customer_tiers.dart) gäller tills admin sparar egna.
    function tierSettings() {
      let path = /databases/$(database)/documents/meta/tiers;
      return exists(path) ? get(path).data : {};
    }

    function tierDiscountFor(customer) {
      let defaults = {'silver': 0.5, 'gold': 1, 'diamond': 1.5};
      return customer.get('tierDiscount', null) != null
        ? customer.tierDiscount
        : tierSettings().get('discounts', {}).get(customer.tier, defaults[customer.tier]);
    }

    // Kundens förfrågan bär nivån och rabatten så att managern ser dem
    // (managern läser inte kundregistret). De måste stämma med kundposten,
    // och kunder utan nivå får inte skicka några.
    function hasValidTierSnapshot() {
      let path = /databases/$(database)/documents/customers/$(request.auth.uid);
      let customer = exists(path) ? get(path).data : {};
      let d = request.resource.data;
      return customer.get('tier', null) in ['silver', 'gold', 'diamond']
        ? d.get('customerTier', null) == customer.tier
          && d.get('tierDiscount', null) == tierDiscountFor(customer)
        : !d.keys().hasAny(['customerTier', 'tierDiscount']);
    }

    // ─── KÖP ────────────────────────────────────────────────────────
    // Ett köp (kind == 'buy') anger hur mycket kunden vill få (buyAmount i
    // toCurrency) och hur: kontant på kontoret eller till kundens bank.
    // Vad kunden ska betala (amountFrom) räknar managern ut i sitt förslag.
    function isBuy(data) {
      return data.get('kind', '') == 'buy';
    }

    // En försäljning (kind == 'sell') anger hur mycket kunden säljer
    // (amountFrom) och hur hen vill få pengarna, kontant eller till banken.
    function hasValidAmounts(d) {
      return isBuy(d)
        ? d.buyAmount is number && d.buyAmount > 0
          && d.deliveryMethod in ['cash', 'bank']
          && d.get('amountFrom', null) == null
        : d.get('kind', '') == 'sell'
        ? d.amountFrom is number && d.amountFrom > 0
          && d.deliveryMethod in ['cash', 'bank']
          && !d.keys().hasAny(['buyAmount'])
        : d.amountFrom is number && d.amountFrom > 0
          && !d.keys().hasAny(['kind', 'buyAmount', 'deliveryMethod']);
    }

    // Bankuppgifter som kunden fyller i för utbetalning till banken.
    function isShortText(d, key) {
      return d.get(key, '') is string
        && d.get(key, '').size() > 0
        && d.get(key, '').size() <= 100;
    }

    // ─── USERS ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);

      // Ny användare får bara skapa sitt eget konto, och bara som kund.
      // Managers och admins skapas av en admin (som skriver som admin).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys()
             .hasOnly(['email', 'firstName', 'lastName', 'phone', 'role', 'createAt']);

      // Admin får göra allt (skapa managers, koppla kontor, radera).
      allow write: if isAdmin();

      // Användare får uppdatera sig själva men inte ändra role/officeId/clientId.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'officeId', 'clientId']);
    }

    // ─── CUSTOMERS ──────────────────────────────────────────────────
    match /customers/{docId} {
      // Admin och managers läser alla kunder (managern väljer kund när hen
      // skapar en transaktion på kontoret). Kunden läser sin egen post.
      allow read: if isAdmin()
        || isManager()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      // En inbjuden kund (länk via SMS) läser sin post med dokument-ID:t i
      // länken, för att fylla i registreringen. ID:t går inte att gissa.
      allow get: if resource.data.get('inviteCode', '') != '';

      allow write: if isAdmin();

      // Kunden skapar sin egen post en gång (dokument-ID = uid).
      // clientId måste komma från räknaren i meta/customers och räknaren
      // måste ha ökats med exakt 1 i samma transaktion.
      allow create: if isCustomer()
        && docId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['clientId', 'firstName', 'lastName', 'email', 'phone', 'userId', 'createAt'])
        && request.resource.data.clientId is int
        && getAfter(metaCustomersPath()).data.lastClientId == lastClientIdBefore() + 1
        && request.resource.data.clientId == getAfter(metaCustomersPath()).data.lastClientId;

      // Inbjuden kund: skapar customers/{uid} med samma klient-ID och nivå
      // som den inbjudna posten (koden i länken måste stämma) och tar bort
      // den gamla posten i samma batch.
      allow create: if isCustomer()
        && docId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'clientId', 'firstName', 'lastName', 'email', 'phone', 'userId',
             'createAt', 'inviteDocId', 'inviteCode', 'tier', 'tierDiscount'
           ])
        && claimsInvite(request.resource.data);

      allow delete: if isCustomer()
        && resource.data.get('inviteCode', '') != ''
        && !('userId' in resource.data)
        && getAfter(/databases/$(database)/documents/customers/$(request.auth.uid))
             .data.get('inviteDocId', '') == docId;

      // Managern skapar en kund som vill bli kund (med inbjudan). Klient-ID:t
      // kommer från räknaren, precis som vid registrering.
      allow create: if isManager()
        && request.resource.data.keys().hasOnly([
             'clientId', 'firstName', 'lastName', 'phone', 'createAt',
             'inviteCode', 'invitedAt', 'createdByManagerId'
           ])
        && request.resource.data.createdByManagerId == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 24
        && request.resource.data.clientId is int
        && getAfter(metaCustomersPath()).data.lastClientId == lastClientIdBefore() + 1
        && request.resource.data.clientId == getAfter(metaCustomersPath()).data.lastClientId;

      // Managern bjuder in en befintlig kund som saknar konto.
      allow update: if isManager()
        && !('userId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['inviteCode', 'invitedAt'])
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 24;

      // Kunden får ändra sina kontaktuppgifter men inte clientId/userId.
      allow update: if isCustomer()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['clientId', 'userId', 'createAt', 'tier', 'tierDiscount']);
    }

    // Den inbjudna posten: koden stämmer, ingen har tagit den än, och
    // klient-ID och nivå följer med oförändrade.
    function claimsInvite(d) {
      let path = /databases/$(database)/documents/customers/$(d.get('inviteDocId', 'x'));
      let invited = get(path).data;
      return d.inviteDocId is string
        && invited.get('inviteCode', '') != ''
        && d.get('inviteCode', '') == invited.inviteCode
        && !('userId' in invited)
        && d.clientId == invited.clientId
        && d.get('tier', null) == invited.get('tier', null)
        && d.get('tierDiscount', null) == invited.get('tierDiscount', null)
        && !existsAfter(path);
    }

    // ─── META ───────────────────────────────────────────────────────
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Kunder (vid registrering) och managers (ny kund på kontoret) får bara
      // räkna upp kundräknaren med exakt 1.
      allow create: if docId == 'customers'
        && (isCustomer() || isManager())
        && request.resource.data.keys().hasOnly(['lastClientId'])
        && request.resource.data.lastClientId == 1;

      allow update: if docId == 'customers'
        && (isCustomer() || isManager())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastClientId'])
        && request.resource.data.lastClientId == resource.data.get('lastClientId', 0) + 1;

      // Transaktionsräknaren räknas upp med exakt 1 när kund eller manager
      // skapar en transaktion (se hasNextTransactionNo).
      allow create: if docId == 'transactions'
        && (isCustomer() || isManager())
        && request.resource.data.keys().hasOnly(['lastTransactionNo'])
        && request.resource.data.lastTransactionNo == 1;

      allow update: if docId == 'transactions'
        && (isCustomer() || isManager())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastTransactionNo'])
        && request.resource.data.lastTransactionNo == resource.data.get('lastTransactionNo', 0) + 1;
    }

    // Kontrollerar att saldoändringen på kontoret motsvarar den transaktion som
    // samtidigt sätts till completed (se offices-regeln).
    function bookingMatchesTransaction(officeId) {
      let txPath = /databases/$(database)/documents/transactions/$(request.resource.data.lastBookedTransactionId);
      let before = get(txPath).data;
      let after = getAfter(txPath).data;
      let oldB = resource.data.balances;
      let newB = request.resource.data.balances;
      return before.officeId == officeId
        && before.status == 'payment_confirmed'
        && after.status == 'completed'
        && newB.diff(oldB).affectedKeys().hasOnly([before.fromCurrency, before.toCurrency])
        && math.abs(newB.get(before.fromCurrency, 0) - (oldB.get(before.fromCurrency, 0) + before.amountFrom)) < 0.01
        && math.abs(newB.get(before.toCurrency, 0) - (oldB.get(before.toCurrency, 0) - before.amountToNet)) < 0.01
        && newB.get(before.toCurrency, 0) >= 0;
    }

    // ─── OFFICES (privat: saldon, betalningsuppgifter, manager) ─────
    match /offices/{officeId} {
      allow read, write: if isAdmin();

      // Manager läser bara sitt eget kontor.
      allow read: if isManager()
        && myOfficeId() != null
        && myOfficeId() == officeId;

      // Manager får bara bokföra saldot för EN transaktion i sitt kontor, i
      // samma batch som transaktionen går från customer_accepted till
      // completed. Kontoret får fromCurrency +amountFrom och toCurrency
      // -amountToNet, ingenting annat får ändras och saldot får inte bli < 0.
      allow update: if isManager()
        && myOfficeId() != null
        && myOfficeId() == officeId
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['balances', 'lastBookedTransactionId'])
        && request.resource.data.lastBookedTransactionId is string
        && bookingMatchesTransaction(officeId);

      // Växling med en partner: kontorets saldo bokförs i samma batch som
      // växlingen blir genomförd, av den som bekräftar sist (manager eller
      // partner). Se partnerExchanges.
      allow update: if (isPartner()
          || (isManager() && myOfficeId() != null && myOfficeId() == officeId))
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['balances', 'lastPartnerExchangeId'])
        && request.resource.data.lastPartnerExchangeId is string
        && officeBookingMatchesExchange(officeId);
    }

    // ─── KASSÖRER ───────────────────────────────────────────────────
    // cashiers/{uid}: privat (saldon, koppling till kontor/manager).
    // cashierDirectory/{uid}: namn och koppling, för listan över mottagare.
    // cashierTransfers/{id}: överföringar mellan kassörer.
    //
    // Saldot flyttas alltid i samma batch som överföringen ändrar status:
    //   skicka   (ny, pending)      avsändaren  -belopp (reserveras)
    //   avbryt   (pending→cancelled) avsändaren +belopp
    //   ta emot  (pending→accepted)  mottagaren +belopp
    //   neka     (pending→rejected)  avsändaren +belopp (skrivs av mottagaren)
    // Kassörens post pekar på överföringen med lastTransferId, så reglerna
    // kan kontrollera att saldoändringen motsvarar just den överföringen.

    function cashierPath(uid) {
      return /databases/$(database)/documents/cashiers/$(uid);
    }

    function cashierDirPath(uid) {
      return /databases/$(database)/documents/cashierDirectory/$(uid);
    }

    function cashierTransferPath(id) {
      return /databases/$(database)/documents/cashierTransfers/$(id);
    }

    // Saldot i valutan ändras med exakt delta, inget annat ändras och
    // saldot blir aldrig negativt.
    function balanceChangedBy(currency, delta) {
      let oldB = resource.data.get('balances', {});
      let newB = request.resource.data.get('balances', {});
      return newB.diff(oldB).affectedKeys().hasOnly([currency])
        && math.abs(newB.get(currency, 0) - (oldB.get(currency, 0) + delta)) < 0.000001
        && newB.get(currency, 0) >= 0;
    }

    function cashierBalanceMatchesTransfer(cid) {
      let tPath = cashierTransferPath(request.resource.data.lastTransferId);
      let after = getAfter(tPath).data;
      return
        // Skicka: överföringen skapas nu, avsändaren reserverar beloppet.
        (cid == request.auth.uid
          && !exists(tPath)
          && after.fromId == cid
          && after.status == 'pending'
          && balanceChangedBy(after.currency, -after.amount))
        // Avbryta, ta emot eller neka: från pending i samma batch.
        || (exists(tPath)
          && get(tPath).data.status == 'pending'
          && (
            (cid == request.auth.uid
              && get(tPath).data.fromId == cid
              && after.status == 'cancelled'
              && balanceChangedBy(get(tPath).data.currency, get(tPath).data.amount))
            || (cid == request.auth.uid
              && get(tPath).data.toId == cid
              && after.status == 'accepted'
              && balanceChangedBy(get(tPath).data.currency, get(tPath).data.amount))
            || (get(tPath).data.toId == request.auth.uid
              && get(tPath).data.fromId == cid
              && after.status == 'rejected'
              && balanceChangedBy(get(tPath).data.currency, get(tPath).data.amount))
          ));
    }

    function managesCashier(data) {
      return isManager()
        && (data.get('managerId', null) == request.auth.uid
            || (myOfficeId() != null && data.get('officeId', null) == myOfficeId()));
    }

    match /cashiers/{cid} {
      allow read: if isAdmin()
        || request.auth.uid == cid
        || managesCashier(resource.data);
      allow write: if isAdmin();

      // Kassörer flyttar saldo bara via en överföring (se ovan).
      allow update: if isCashier()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['balances', 'lastTransferId'])
        && request.resource.data.lastTransferId is string
        && cashierBalanceMatchesTransfer(cid);
    }

    // ─── PARTNER ────────────────────────────────────────────────
    // partners/{uid}: privat (saldon, koppling till kontor/manager). Admin
    // sparar också exchangeOfficeId: kontoret vars saldo växlingarna går mot
    // (det kopplade kontoret, annars den kopplade managerns kontor).
    //
    // partnerExchanges/{id}: växling mellan ett kontor och en partner,
    // utan avgift. Sidan "office" ger officeGivesAmount i
    // officeGivesCurrency och får partnerGivesAmount i partnerGivesCurrency.
    //   proposed  den ena sidan föreslår; den andra accepterar, avböjer eller
    //             ändrar beloppen (motförslag); den som föreslog kan avbryta
    //   accepted  var sida markerar "skickat" och sedan "mottaget" när den
    //             andras pengar har kommit
    //   completed när båda har tagit emot; saldona för kontoret och
    //             partnern bokförs i samma batch
    function partnerPath(uid) {
      return /databases/$(database)/documents/partners/$(uid);
    }

    function exchangePath(id) {
      return /databases/$(database)/documents/partnerExchanges/$(id);
    }

    function managesPartner(data) {
      return isManager()
        && (data.get('managerId', null) == request.auth.uid
            || (myOfficeId() != null && data.get('officeId', null) == myOfficeId()));
    }

    // Vilken sida den inloggade är i växlingen: 'office', 'partner' eller ''.
    function exchangeSide(ex) {
      let me = hasProfile() ? get(userPath()).data : {};
      return me.get('role', '') == 'manager'
          && me.get('officeId', null) != null
          && ex.officeId == me.get('officeId', null)
        ? 'office'
        : me.get('role', '') == 'partner' && ex.partnerId == request.auth.uid
        ? 'partner'
        : '';
    }

    // Ändringar av en växling. side är den inloggades sida (se ovan) och
    // räknas ut en gång, så att reglerna håller sig inom Firestores gräns.
    function exchangeUpdateAllowed(old, new, side, eid) {
      let other = side == 'office' ? 'partner' : 'office';
      let changed = new.diff(old).affectedKeys();
      return side != ''
        && new.partnerId == old.partnerId
        && new.officeId == old.officeId
        && (
          // Förslag: den andra sidan accepterar, avböjer eller ändrar
          // beloppen; den som föreslog kan avbryta.
          (old.status == 'proposed'
            && (
              (side != old.proposedBy
                && new.status == 'proposed'
                && new.proposedBy == side
                && hasValidExchangeTerms(new)
                && changed.hasOnly(['officeGivesAmount', 'partnerGivesAmount',
                                    'proposedBy', 'note', 'updatedAt']))
              || (side != old.proposedBy
                && new.status in ['accepted', 'rejected']
                && changed.hasOnly(['status', 'decidedAt']))
              || (side == old.proposedBy
                && new.status == 'cancelled'
                && changed.hasOnly(['status', 'decidedAt']))
            ))
          // Accepterad: markera att de egna pengarna är skickade, med ett
          // valfritt kvitto i Storage under exchangeReceipts/{id}/{sida}/.
          || (old.status == 'accepted'
            && new.status == 'accepted'
            && new.get(side + 'Sent', false) == true
            && changed.hasOnly([side + 'Sent', side + 'SentAt',
                                side + 'ReceiptPath', side + 'ReceiptName',
                                side + 'ReceiptContentType'])
            && (!(side + 'ReceiptPath' in new)
                || new[side + 'ReceiptPath'].matches(
                     'exchangeReceipts/' + eid + '/' + side + '/.+')))
          // Accepterad: markera att den andra sidans pengar har kommit. Den
          // som bekräftar sist gör växlingen genomförd och bokför båda
          // saldona i samma batch.
          || (old.status == 'accepted'
            && old.get(other + 'Sent', false) == true
            && new.get(side + 'Received', false) == true
            && (
              (old.get(other + 'Received', false) != true
                && new.status == 'accepted'
                && changed.hasOnly([side + 'Received', side + 'ReceivedAt']))
              || (old.get(other + 'Received', false) == true
                && new.status == 'completed'
                && changed.hasOnly([side + 'Received', side + 'ReceivedAt',
                                    'status', 'completedAt'])
                && getAfter(/databases/$(database)/documents/offices/$(old.officeId))
                     .data.get('lastPartnerExchangeId', '') == eid
                && getAfter(partnerPath(old.partnerId))
                     .data.get('lastExchangeId', '') == eid)
            ))
        );
    }

    function hasValidExchangeTerms(d) {
      return d.officeGivesCurrency is string
        && d.partnerGivesCurrency is string
        && d.officeGivesCurrency != d.partnerGivesCurrency
        && d.officeGivesAmount is number && d.officeGivesAmount > 0
        && d.partnerGivesAmount is number && d.partnerGivesAmount > 0
        && d.get('note', '') is string && d.get('note', '').size() <= 500;
    }

    // Kontoret ger officeGives och får partnerGives; saldot får inte bli < 0.
    function officeBookingMatchesExchange(officeId) {
      let path = exchangePath(request.resource.data.lastPartnerExchangeId);
      let ex = get(path).data;
      let oldB = resource.data.get('balances', {});
      let newB = request.resource.data.get('balances', {});
      return ex.officeId == officeId
        && ex.status == 'accepted'
        && getAfter(path).data.status == 'completed'
        && (!isPartner() || ex.partnerId == request.auth.uid)
        && newB.diff(oldB).affectedKeys().hasOnly([ex.officeGivesCurrency, ex.partnerGivesCurrency])
        && math.abs(newB.get(ex.officeGivesCurrency, 0) - (oldB.get(ex.officeGivesCurrency, 0) - ex.officeGivesAmount)) < 0.01
        && math.abs(newB.get(ex.partnerGivesCurrency, 0) - (oldB.get(ex.partnerGivesCurrency, 0) + ex.partnerGivesAmount)) < 0.01
        && newB.get(ex.officeGivesCurrency, 0) >= 0;
    }

    // Partnern får officeGives och ger partnerGives.
    function partnerBookingMatchesExchange(pid) {
      let path = exchangePath(request.resource.data.lastExchangeId);
      let ex = get(path).data;
      let oldB = resource.data.get('balances', {});
      let newB = request.resource.data.get('balances', {});
      return ex.partnerId == pid
        && ex.status == 'accepted'
        && getAfter(path).data.status == 'completed'
        && (!isManager() || ex.officeId == myOfficeId())
        && newB.diff(oldB).affectedKeys().hasOnly([ex.officeGivesCurrency, ex.partnerGivesCurrency])
        && math.abs(newB.get(ex.officeGivesCurrency, 0) - (oldB.get(ex.officeGivesCurrency, 0) + ex.officeGivesAmount)) < 0.01
        && math.abs(newB.get(ex.partnerGivesCurrency, 0) - (oldB.get(ex.partnerGivesCurrency, 0) - ex.partnerGivesAmount)) < 0.01;
    }

    match /partners/{pid} {
      allow read: if isAdmin()
        || request.auth.uid == pid
        || managesPartner(resource.data);
      allow write: if isAdmin();

      // Partnern fyller själv på (eller drar av) sitt saldo, så att
      // managern ser vilka valutor partnern har. Saldot får inte bli < 0
      // i den valuta som ändras.
      allow update: if isPartner()
        && request.auth.uid == pid
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['balances', 'balancesUpdatedAt', 'lastAdjustedCurrency'])
        && request.resource.data.lastAdjustedCurrency is string
        && request.resource.data.get('balances', {})
             .diff(resource.data.get('balances', {})).affectedKeys()
             .hasOnly([request.resource.data.lastAdjustedCurrency])
        && request.resource.data.balances
             .get(request.resource.data.lastAdjustedCurrency, 0) >= 0;

      // Saldot ändras annars bara när en växling blir genomförd (se ovan).
      allow update: if (request.auth.uid == pid || isManager())
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['balances', 'lastExchangeId'])
        && request.resource.data.lastExchangeId is string
        && partnerBookingMatchesExchange(pid);
    }

    match /partnerExchanges/{eid} {
      allow read: if isAdmin()
        || (isPartner() && resource.data.partnerId == request.auth.uid)
        || (isManager() && myOfficeId() != null && resource.data.officeId == myOfficeId());

      allow delete: if isAdmin();

      allow create: if request.resource.data.status == 'proposed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
             'officeId', 'officeLabel', 'managerId', 'partnerId', 'partnerName',
             'officeGivesCurrency', 'officeGivesAmount', 'partnerGivesCurrency',
             'partnerGivesAmount', 'note', 'status', 'proposedBy', 'createdAt'
           ])
        && hasValidExchangeTerms(request.resource.data)
        && exists(partnerPath(request.resource.data.partnerId))
        && (
          // Managern föreslår till en partner som är kopplad till hen.
          (isManager()
            && request.resource.data.proposedBy == 'office'
            && myOfficeId() != null
            && request.resource.data.officeId == myOfficeId()
            && request.resource.data.managerId == request.auth.uid
            && managesPartner(get(partnerPath(request.resource.data.partnerId)).data))
          // Partnern föreslår till kontoret hen är kopplad till.
          || (isPartner()
            && request.resource.data.proposedBy == 'partner'
            && request.resource.data.partnerId == request.auth.uid
            && request.resource.data.officeId
                 == get(partnerPath(request.auth.uid)).data.get('exchangeOfficeId', ''))
        );

      allow update: if exchangeUpdateAllowed(
        resource.data, request.resource.data, exchangeSide(resource.data), eid);
    }

    match /cashierDirectory/{cid} {
      allow read: if isAdmin() || isCashier() || isManager();
      allow write: if isAdmin();
    }

    match /cashierTransfers/{tid} {
      allow read: if isAdmin()
        || resource.data.fromId == request.auth.uid
        || resource.data.toId == request.auth.uid
        || (isManager()
            && (resource.data.get('fromManagerId', null) == request.auth.uid
                || resource.data.get('toManagerId', null) == request.auth.uid
                || (myOfficeId() != null
                    && (resource.data.get('fromOfficeId', null) == myOfficeId()
                        || resource.data.get('toOfficeId', null) == myOfficeId()))));

      allow write: if isAdmin();

      // Skicka till en annan kassör. Koppling till kontor/manager kopieras
      // från katalogen (för managerns vy) och måste stämma med den.
      allow create: if isCashier()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && exists(cashierDirPath(request.resource.data.toId))
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 500
        && request.resource.data.keys().hasOnly([
             'fromId', 'fromName', 'toId', 'toName', 'currency', 'amount',
             'note', 'status', 'createdAt', 'fromOfficeId', 'fromManagerId',
             'toOfficeId', 'toManagerId'
           ])
        && request.resource.data.get('fromOfficeId', null)
             == get(cashierDirPath(request.auth.uid)).data.get('officeId', null)
        && request.resource.data.get('fromManagerId', null)
             == get(cashierDirPath(request.auth.uid)).data.get('managerId', null)
        && request.resource.data.get('toOfficeId', null)
             == get(cashierDirPath(request.resource.data.toId)).data.get('officeId', null)
        && request.resource.data.get('toManagerId', null)
             == get(cashierDirPath(request.resource.data.toId)).data.get('managerId', null)
        && getAfter(cashierPath(request.auth.uid)).data.lastTransferId == tid;

      allow update: if isCashier()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedAt'])
        && (
          (resource.data.toId == request.auth.uid
            && request.resource.data.status == 'accepted'
            && getAfter(cashierPath(request.auth.uid)).data.lastTransferId == tid)
          || (resource.data.toId == request.auth.uid
            && request.resource.data.status == 'rejected'
            && getAfter(cashierPath(resource.data.fromId)).data.lastTransferId == tid)
          || (resource.data.fromId == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && getAfter(cashierPath(request.auth.uid)).data.lastTransferId == tid)
        );
    }

    // ─── OFFICE LISTINGS (publik, ofarlig kopia för kunder) ─────────
    // Innehåller bara land, stad och valutor. Skrivs av admin-appen.
    match /officeListings/{officeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── TRANSACTIONS ───────────────────────────────────────────────
    // Kassörens kontor: det kopplade kontoret, annars den kopplade
    // managerns kontor.
    function cashierOfficeId() {
      let c = get(cashierPath(request.auth.uid)).data;
      return c.get('officeId', null) != null
        ? c.officeId
        : c.get('cashOfficeId', null) != null
        ? c.cashOfficeId
        : c.get('managerId', null) != null
        ? get(/databases/$(database)/documents/users/$(c.managerId)).data.get('officeId', null)
        : null;
    }

    match /transactions/{docId} {
      // Kassören ser kontorets transaktioner (för kontanta inbetalningar).
      allow read: if isCashier()
        && cashierOfficeId() != null
        && resource.data.officeId == cashierOfficeId();

      // Kassören bekräftar en kontant inbetalning på kontoret och skapar
      // uthämtningskoden, precis som managern. Kontorets saldo bokförs
      // först när transaktionen genomförs.
      allow update: if isCashier()
        && resource.data.get('payMethod', 'bank') == 'cash'
        && resource.data.status == 'customer_accepted'
        && cashierOfficeId() != null
        && resource.data.officeId == cashierOfficeId()
        && request.resource.data.status == 'payment_confirmed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'pickupCode', 'pickupToken', 'paymentConfirmedAt',
             'paymentConfirmedBy'
           ])
        && request.resource.data.paymentConfirmedBy == request.auth.uid
        && request.resource.data.pickupCode is string
        && request.resource.data.pickupCode.matches('[0-9]{6}-[0-9]{4}-[0-9]{4}')
        && request.resource.data.pickupToken is string
        && request.resource.data.pickupToken.size() == 32;

      allow read: if isAdmin()
        || (isManager()
            && myOfficeId() != null
            && resource.data.officeId == myOfficeId())
        || (isCustomer() && resource.data.customerId == request.auth.uid)
        // Transaktioner som managern skapat på kontoret för kunden (innan
        // kunden hade konto) hittas via klient-ID:t.
        || (isCustomer()
            && resource.data.customerId == ''
            && resource.data.get('clientId', '') != ''
            && resource.data.clientId == string(get(
                 /databases/$(database)/documents/customers/$(request.auth.uid)).data.clientId));

      // Kunden skickar en förfrågan. Kontoret måste finnas i officeListings
      // och hantera både från- och tillvaluta.
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'customer_requested'
        && request.resource.data.createAt == request.time
        && request.resource.data.keys().hasOnly([
             'customerId', 'clientId', 'customerName', 'customerPhone',
             'officeId', 'fromCurrency', 'toCurrency', 'amountFrom',
             'amountTo', 'feePercent', 'feeAmount', 'paymentMethod',
             'status', 'createAt', 'transactionNo',
             'customerTier', 'tierDiscount',
             'kind', 'buyAmount', 'deliveryMethod', 'payMethod'
           ])
        && hasValidTransactionNo()
        // Kunden betalar kontant på kontoret eller via bank (som förut).
        && request.resource.data.get('payMethod', 'bank') in ['cash', 'bank']
        && hasValidTierSnapshot()
        && hasValidAmounts(request.resource.data)
        && request.resource.data.officeId is string
        && request.resource.data.fromCurrency is string
        && request.resource.data.toCurrency is string
        && request.resource.data.fromCurrency != request.resource.data.toCurrency
        && exists(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId))
        && request.resource.data.fromCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies
        && request.resource.data.toCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies;

      // Manager registrerar en kund som kommer in på kontoret (utan konto).
      // Villkoren är redan överenskomna, så den börjar som customer_accepted.
      allow create: if isManager()
        && myOfficeId() != null
        && request.resource.data.officeId == myOfficeId()
        && request.resource.data.customerId == ''
        && request.resource.data.createdByManager == true
        && request.resource.data.status == 'customer_accepted'
        && request.resource.data.createAt == request.time
        && request.resource.data.keys().hasOnly([
             'customerId', 'customerName', 'customerPhone', 'officeId',
             'fromCurrency', 'toCurrency', 'amountFrom', 'feePercent',
             'feeAmountFrom', 'rateFromTo', 'amountToGross', 'amountToNet',
             'feeAmountTo', 'status', 'createAt', 'createdByManager',
             'transactionNo', 'clientId', 'customerDocId', 'payMethod'
           ])
        && request.resource.data.get('payMethod', 'bank') in ['cash', 'bank']
        && hasValidTransactionNo()
        // Vald kund ur kundregistret: klient-ID:t måste vara kundens.
        && (!request.resource.data.keys().hasAny(['clientId', 'customerDocId'])
            || (request.resource.data.clientId is string
                && request.resource.data.customerDocId is string
                && request.resource.data.clientId == string(getAfter(
                     /databases/$(database)/documents/customers/$(request.resource.data.customerDocId)).data.clientId)))
        && request.resource.data.amountFrom is number
        && request.resource.data.amountFrom > 0
        && request.resource.data.amountToNet is number
        && request.resource.data.amountToNet > 0
        && request.resource.data.fromCurrency != request.resource.data.toCurrency
        && request.resource.data.fromCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies
        && request.resource.data.toCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies;

      // Admin får ändra allt utom att flytta en genomförd transaktion från
      // genomförd (den är bokförd och ska räknas i vinsten).
      allow update: if (isAdmin()
          && (resource.data.status != 'completed'
              || request.resource.data.status == 'completed'))

        // Manager: föreslå villkor, eller markera genomförd efter kundens accept.
        || (
          isManager()
          && myOfficeId() != null
          && resource.data.officeId == myOfficeId()
          && request.resource.data.officeId == resource.data.officeId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
               'status', 'feePercent', 'feeAmountFrom', 'rateFromTo',
               'amountToGross', 'amountToNet', 'feeAmountTo',
               'chosenPaymentMethodId', 'paymentMethodLabel',
               'paymentMethodDetails', 'paymentSentAt',
               'managerProposedAt', 'completedAt',
               'pickupCode', 'pickupToken', 'paymentConfirmedAt',
               'paymentIssueNote', 'paymentIssueAt', 'payoutCode',
               'baseFeePercent', 'amountFrom', 'paidOutToBankAt'
             ])
          // Beloppet kunden betalar ändras bara när managern föreslår villkor
          // för ett köp (se nedan).
          && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['amountFrom'])
              || (isBuy(resource.data)
                  && request.resource.data.status in ['manager_proposed', 'customer_accepted']))
          && (
            (
              request.resource.data.status == 'manager_proposed'
              && resource.data.status in ['customer_requested', 'manager_proposed', 'customer_countered']
              // Kunder med nivå: avgiften är managerns avgift (baseFeePercent)
              // minus nivåns rabatt, men aldrig under 0.
              && (!('tierDiscount' in resource.data)
                  || (request.resource.data.baseFeePercent is number
                      && request.resource.data.feePercent ==
                           (request.resource.data.baseFeePercent > resource.data.tierDiscount
                             ? request.resource.data.baseFeePercent - resource.data.tierDiscount
                             : 0)))
              // Köp: kunden ska få exakt det belopp hen vill köpa.
              && (!isBuy(resource.data)
                  || (request.resource.data.amountFrom is number
                      && request.resource.data.amountFrom > 0
                      && request.resource.data.amountToNet is number
                      && math.abs(request.resource.data.amountToNet - resource.data.buyAmount) < 0.01))
            )
            // Acceptera kundens motförslag: kundens avgift, samma växelkurs.
            || (
              request.resource.data.status == 'customer_accepted'
              && resource.data.status == 'customer_countered'
              && request.resource.data.feePercent == resource.data.counterFeePercent
              && request.resource.data.rateFromTo == resource.data.rateFromTo
              // Köp: kunden får fortfarande det hen köper, men betalar mindre.
              && (!isBuy(resource.data)
                  || math.abs(request.resource.data.amountToNet - resource.data.buyAmount) < 0.01)
            )
            // Skicka betalningsuppgifter till kunden efter accept (status oförändrad).
            || (
              request.resource.data.status == 'customer_accepted'
              && resource.data.status == 'customer_accepted'
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'chosenPaymentMethodId', 'paymentMethodLabel',
                   'paymentMethodDetails', 'paymentSentAt'
                 ])
            )
            // Genomförd bara i samma batch som kontorets saldo bokförs för
            // just den här transaktionen (se offices-regeln).
            // Bekräfta att betalningen har kommit och skapa uthämtningskoden.
            // Från customer_accepted gäller kunder utan konto (de kan inte
            // själva markera betalt).
            || (
              request.resource.data.status == 'payment_confirmed'
              && resource.data.status in ['customer_accepted', 'customer_paid']
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'status', 'pickupCode', 'pickupToken', 'paymentConfirmedAt'
                 ])
              // ÅÅMMDD-XXXX-XXXX och en hemlig nyckel på 32 tecken för QR-koden.
              && request.resource.data.pickupCode is string
              && request.resource.data.pickupCode.matches('[0-9]{6}-[0-9]{4}-[0-9]{4}')
              && request.resource.data.pickupToken is string
              && request.resource.data.pickupToken.size() == 32
            )
            // Betalningen har inte kommit: tillbaka till kunden med meddelande.
            || (
              request.resource.data.status == 'customer_accepted'
              && resource.data.status == 'customer_paid'
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'status', 'paymentIssueNote', 'paymentIssueAt'
                 ])
            )
            || (
              request.resource.data.status == 'completed'
              && resource.data.status == 'payment_confirmed'
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'status', 'completedAt', 'payoutCode', 'paidOutToBankAt'
                 ])
              // Kontant: rätt uthämtningskod. Bank: kunden har fyllt i sina
              // bankuppgifter och managern har skickat pengarna dit.
              && (resource.data.get('deliveryMethod', 'cash') == 'bank'
                  ? isShortText(resource.data, 'bankAccountHolder')
                  : request.resource.data.payoutCode == resource.data.pickupCode)
              && getAfter(/databases/$(database)/documents/offices/$(resource.data.officeId))
                   .data.get('lastBookedTransactionId', '') == docId
            )
          )
        )

        // Kund: acceptera eller avböja ett förslag från managern.
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'manager_proposed'
          && request.resource.data.status in ['customer_accepted', 'customer_rejected']
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['status', 'customerDecisionAt'])
        )

        // Kund: markera som betalt (med ev. kvitto och meddelande) när
        // betalningsuppgifterna har skickats.
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'customer_accepted'
          && resource.data.get('paymentMethodLabel', '') != ''
          && request.resource.data.status == 'customer_paid'
          && request.resource.data.get('paymentNote', '') is string
          && request.resource.data.get('paymentNote', '').size() <= 500
          && (
            !('receiptPath' in request.resource.data)
            || request.resource.data.receiptPath.matches('receipts/' + docId + '/.*')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'customerPaidAt', 'paymentNote', 'receiptPath',
               'receiptName', 'receiptContentType'
             ])
        )

        // Kund: bankuppgifter för utbetalning, när betalningen är bekräftad.
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'payment_confirmed'
          && resource.data.get('deliveryMethod', '') == 'bank'
          && isShortText(request.resource.data, 'bankName')
          && isShortText(request.resource.data, 'bankPhone')
          && isShortText(request.resource.data, 'bankAccountHolder')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'bankName', 'bankPhone', 'bankAccountHolder',
               'bankDetailsAt'
             ])
        )

        // Kund: ett enda motförslag med lägre avgift (och ev. meddelande).
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'manager_proposed'
          && resource.data.get('counterOfferUsed', false) != true
          && request.resource.data.status == 'customer_countered'
          && request.resource.data.counterOfferUsed == true
          && request.resource.data.counterFeePercent is number
          && request.resource.data.counterFeePercent >= 0
          && request.resource.data.counterFeePercent < resource.data.feePercent
          && request.resource.data.get('counterMessage', '') is string
          && request.resource.data.get('counterMessage', '').size() <= 500
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'customerDecisionAt', 'counterOfferUsed',
               'counterFeePercent', 'counterMessage'
             ])
        );

      // Genomförda transaktioner är bokförda affärer och raderas aldrig;
      // appen arkiverar dem i stället (archived: true).
      allow delete: if isAdmin() && resource.data.status != 'completed';
    }

    // ─── CHATT ──────────────────────────────────────────────────────
    // chats/{typ}_{id}: en intern chatt per ärende. typ är 'tx'
    // (kundtransaktion), 'ex' (partnerväxling) eller 'ct' (överföring
    // mellan kassörer). Vem som är med kopieras från ärendet när chatten
    // skapas och kontrolleras mot det:
    //   officeIds         managers på de kontoren
    //   managerIds        managers som kassörerna är kopplade till (ct)
    //   cashierOfficeIds  alla kassörer på de kontoren (tx, ex)
    //   cashierIds        kassörerna i överföringen (ct)
    //   partnerId         partnern i växlingen (ex)
    // Kunder är aldrig med. Meddelanden: chats/{id}/messages/{id}, kan
    // inte ändras eller tas bort (utom av admin).
    function isChatMember(c) {
      let me = hasProfile() ? get(userPath()).data : {};
      let r = me.get('role', '');
      return r == 'admin'
        || (r == 'manager'
            && ((me.get('officeId', null) != null
                 && me.officeId in c.get('officeIds', []))
                || request.auth.uid in c.get('managerIds', [])))
        || (r == 'cashier'
            && (request.auth.uid in c.get('cashierIds', [])
                || cashierOfficeId() in c.get('cashierOfficeIds', [])))
        || (r == 'partner' && c.get('partnerId', '') == request.auth.uid);
    }

    // Deltagarna stämmer med ärendet som chatten hör till.
    function chatMatchesCase(chatId, c) {
      return chatId == c.type + '_' + c.refId
        && (
          (c.type == 'tx'
            && c.officeIds == [get(/databases/$(database)/documents/transactions/$(c.refId)).data.officeId]
            && c.cashierOfficeIds == c.officeIds
            && c.managerIds == [] && c.cashierIds == []
            && c.get('partnerId', '') == '')
          || (c.type == 'ex'
            && c.officeIds == [get(/databases/$(database)/documents/partnerExchanges/$(c.refId)).data.officeId]
            && c.cashierOfficeIds == c.officeIds
            && c.managerIds == [] && c.cashierIds == []
            && c.partnerId == get(/databases/$(database)/documents/partnerExchanges/$(c.refId)).data.partnerId)
          || (c.type == 'ct'
            && c.officeIds == [
                 get(/databases/$(database)/documents/cashierTransfers/$(c.refId)).data.get('fromOfficeId', null),
                 get(/databases/$(database)/documents/cashierTransfers/$(c.refId)).data.get('toOfficeId', null)]
            && c.managerIds == [
                 get(/databases/$(database)/documents/cashierTransfers/$(c.refId)).data.get('fromManagerId', null),
                 get(/databases/$(database)/documents/cashierTransfers/$(c.refId)).data.get('toManagerId', null)]
            && c.cashierIds == [
                 get(/databases/$(database)/documents/cashierTransfers/$(c.refId)).data.fromId,
                 get(/databases/$(database)/documents/cashierTransfers/$(c.refId)).data.toId]
            && c.cashierOfficeIds == []
            && c.get('partnerId', '') == '')
        );
    }

    match /chats/{chatId} {
      // En chatt som inte finns än får "läsas" (appen kollar om den finns).
      allow get: if isSignedIn() && resource == null;
      allow read: if isSignedIn() && isChatMember(resource.data);
      allow delete: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'type', 'refId', 'title', 'officeIds', 'managerIds',
             'cashierOfficeIds', 'cashierIds', 'partnerId', 'createdAt'
           ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && chatMatchesCase(chatId, request.resource.data)
        && isChatMember(request.resource.data);

      // Senaste meddelandet (för listan) och när var och en senast läste.
      // Man sätter bara sin egen läsmarkering.
      allow update: if isSignedIn()
        && isChatMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'lastMessageAt', 'lastText', 'lastSenderId', 'lastSenderName',
             'readBy'
           ])
        && request.resource.data.get('readBy', {})
             .diff(resource.data.get('readBy', {})).affectedKeys()
             .hasOnly([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && isChatMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow delete: if isAdmin();

        allow create: if isSignedIn()
          && isChatMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
               'senderId', 'senderName', 'text', 'createdAt',
               'attachmentPath', 'attachmentName', 'attachmentContentType'
             ])
          && request.resource.data.get('text', '') is string
          && request.resource.data.get('text', '').size() <= 2000
          && (request.resource.data.get('text', '') != ''
              || 'attachmentPath' in request.resource.data)
          && (!('attachmentPath' in request.resource.data)
              || request.resource.data.attachmentPath.matches('chats/' + chatId + '/.+'));
      }
    }
  }
}
