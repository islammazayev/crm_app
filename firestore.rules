rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Hjälpfunktioner ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath());
    }

    function role() {
      return hasProfile() ? get(userPath()).data.get('role', null) : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isManager() {
      return role() == 'manager';
    }

    function isCustomer() {
      return role() == 'customer';
    }

    function myOfficeId() {
      return hasProfile() ? get(userPath()).data.get('officeId', null) : null;
    }

    function metaCustomersPath() {
      return /databases/$(database)/documents/meta/customers;
    }

    function lastClientIdBefore() {
      return exists(metaCustomersPath())
        ? get(metaCustomersPath()).data.get('lastClientId', 0)
        : 0;
    }

    function metaTransactionsPath() {
      return /databases/$(database)/documents/meta/transactions;
    }

    function lastTransactionNoBefore() {
      return exists(metaTransactionsPath())
        ? get(metaTransactionsPath()).data.get('lastTransactionNo', 0)
        : 0;
    }

    // Ny transaktion får nästa löpnummer: räknaren i meta/transactions ökas
    // med exakt 1 i samma skrivning och numret är räknarens nya värde.
    function hasNextTransactionNo() {
      return request.resource.data.transactionNo is int
        && getAfter(metaTransactionsPath()).data.lastTransactionNo == lastTransactionNoBefore() + 1
        && request.resource.data.transactionNo == getAfter(metaTransactionsPath()).data.lastTransactionNo;
    }

    // Numret är valfritt (äldre appversioner skickar inget, och admin numrerar
    // dem i efterhand), men finns det måste det vara nästa lediga nummer.
    function hasValidTransactionNo() {
      return !('transactionNo' in request.resource.data) || hasNextTransactionNo();
    }

    // ─── USERS ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);

      // Ny användare får bara skapa sitt eget konto, och bara som kund.
      // Managers och admins skapas av en admin (som skriver som admin).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys()
             .hasOnly(['email', 'firstName', 'lastName', 'phone', 'role', 'createAt']);

      // Admin får göra allt (skapa managers, koppla kontor, radera).
      allow write: if isAdmin();

      // Användare får uppdatera sig själva men inte ändra role/officeId/clientId.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'officeId', 'clientId']);
    }

    // ─── CUSTOMERS ──────────────────────────────────────────────────
    match /customers/{docId} {
      // Admin läser allt, kund läser bara sin egen post.
      // Managers läser inte kunder: kundens namn och klient-ID sparas
      // i själva transaktionen när kunden skickar sin förfrågan.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow write: if isAdmin();

      // Kunden skapar sin egen post en gång (dokument-ID = uid).
      // clientId måste komma från räknaren i meta/customers och räknaren
      // måste ha ökats med exakt 1 i samma transaktion.
      allow create: if isCustomer()
        && docId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['clientId', 'firstName', 'lastName', 'email', 'phone', 'userId', 'createAt'])
        && request.resource.data.clientId is int
        && getAfter(metaCustomersPath()).data.lastClientId == lastClientIdBefore() + 1
        && request.resource.data.clientId == getAfter(metaCustomersPath()).data.lastClientId;

      // Kunden får ändra sina kontaktuppgifter men inte clientId/userId.
      allow update: if isCustomer()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['clientId', 'userId', 'createAt']);
    }

    // ─── META ───────────────────────────────────────────────────────
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Kunder får bara räkna upp kundräknaren med exakt 1 (vid registrering).
      allow create: if docId == 'customers'
        && isCustomer()
        && request.resource.data.keys().hasOnly(['lastClientId'])
        && request.resource.data.lastClientId == 1;

      allow update: if docId == 'customers'
        && isCustomer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastClientId'])
        && request.resource.data.lastClientId == resource.data.get('lastClientId', 0) + 1;

      // Transaktionsräknaren räknas upp med exakt 1 när kund eller manager
      // skapar en transaktion (se hasNextTransactionNo).
      allow create: if docId == 'transactions'
        && (isCustomer() || isManager())
        && request.resource.data.keys().hasOnly(['lastTransactionNo'])
        && request.resource.data.lastTransactionNo == 1;

      allow update: if docId == 'transactions'
        && (isCustomer() || isManager())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastTransactionNo'])
        && request.resource.data.lastTransactionNo == resource.data.get('lastTransactionNo', 0) + 1;
    }

    // Kontrollerar att saldoändringen på kontoret motsvarar den transaktion som
    // samtidigt sätts till completed (se offices-regeln).
    function bookingMatchesTransaction(officeId) {
      let txPath = /databases/$(database)/documents/transactions/$(request.resource.data.lastBookedTransactionId);
      let before = get(txPath).data;
      let after = getAfter(txPath).data;
      let oldB = resource.data.balances;
      let newB = request.resource.data.balances;
      return before.officeId == officeId
        && before.status == 'payment_confirmed'
        && after.status == 'completed'
        && newB.diff(oldB).affectedKeys().hasOnly([before.fromCurrency, before.toCurrency])
        && math.abs(newB.get(before.fromCurrency, 0) - (oldB.get(before.fromCurrency, 0) + before.amountFrom)) < 0.01
        && math.abs(newB.get(before.toCurrency, 0) - (oldB.get(before.toCurrency, 0) - before.amountToNet)) < 0.01
        && newB.get(before.toCurrency, 0) >= 0;
    }

    // ─── OFFICES (privat: saldon, betalningsuppgifter, manager) ─────
    match /offices/{officeId} {
      allow read, write: if isAdmin();

      // Manager läser bara sitt eget kontor.
      allow read: if isManager()
        && myOfficeId() != null
        && myOfficeId() == officeId;

      // Manager får bara bokföra saldot för EN transaktion i sitt kontor, i
      // samma batch som transaktionen går från customer_accepted till
      // completed. Kontoret får fromCurrency +amountFrom och toCurrency
      // -amountToNet, ingenting annat får ändras och saldot får inte bli < 0.
      allow update: if isManager()
        && myOfficeId() != null
        && myOfficeId() == officeId
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['balances', 'lastBookedTransactionId'])
        && request.resource.data.lastBookedTransactionId is string
        && bookingMatchesTransaction(officeId);
    }

    // ─── OFFICE LISTINGS (publik, ofarlig kopia för kunder) ─────────
    // Innehåller bara land, stad och valutor. Skrivs av admin-appen.
    match /officeListings/{officeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── TRANSACTIONS ───────────────────────────────────────────────
    match /transactions/{docId} {
      allow read: if isAdmin()
        || (isManager()
            && myOfficeId() != null
            && resource.data.officeId == myOfficeId())
        || (isCustomer() && resource.data.customerId == request.auth.uid);

      // Kunden skickar en förfrågan. Kontoret måste finnas i officeListings
      // och hantera både från- och tillvaluta.
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'customer_requested'
        && request.resource.data.createAt == request.time
        && request.resource.data.keys().hasOnly([
             'customerId', 'clientId', 'customerName', 'customerPhone',
             'officeId', 'fromCurrency', 'toCurrency', 'amountFrom',
             'amountTo', 'feePercent', 'feeAmount', 'paymentMethod',
             'status', 'createAt', 'transactionNo'
           ])
        && hasValidTransactionNo()
        && request.resource.data.amountFrom is number
        && request.resource.data.amountFrom > 0
        && request.resource.data.officeId is string
        && request.resource.data.fromCurrency is string
        && request.resource.data.toCurrency is string
        && request.resource.data.fromCurrency != request.resource.data.toCurrency
        && exists(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId))
        && request.resource.data.fromCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies
        && request.resource.data.toCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies;

      // Manager registrerar en kund som kommer in på kontoret (utan konto).
      // Villkoren är redan överenskomna, så den börjar som customer_accepted.
      allow create: if isManager()
        && myOfficeId() != null
        && request.resource.data.officeId == myOfficeId()
        && request.resource.data.customerId == ''
        && request.resource.data.createdByManager == true
        && request.resource.data.status == 'customer_accepted'
        && request.resource.data.createAt == request.time
        && request.resource.data.keys().hasOnly([
             'customerId', 'customerName', 'customerPhone', 'officeId',
             'fromCurrency', 'toCurrency', 'amountFrom', 'feePercent',
             'feeAmountFrom', 'rateFromTo', 'amountToGross', 'amountToNet',
             'feeAmountTo', 'status', 'createAt', 'createdByManager',
             'transactionNo'
           ])
        && hasValidTransactionNo()
        && request.resource.data.amountFrom is number
        && request.resource.data.amountFrom > 0
        && request.resource.data.amountToNet is number
        && request.resource.data.amountToNet > 0
        && request.resource.data.fromCurrency != request.resource.data.toCurrency
        && request.resource.data.fromCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies
        && request.resource.data.toCurrency in
             get(/databases/$(database)/documents/officeListings/$(request.resource.data.officeId)).data.currencies;

      allow update: if isAdmin()

        // Manager: föreslå villkor, eller markera genomförd efter kundens accept.
        || (
          isManager()
          && myOfficeId() != null
          && resource.data.officeId == myOfficeId()
          && request.resource.data.officeId == resource.data.officeId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
               'status', 'feePercent', 'feeAmountFrom', 'rateFromTo',
               'amountToGross', 'amountToNet', 'feeAmountTo',
               'chosenPaymentMethodId', 'paymentMethodLabel',
               'paymentMethodDetails', 'paymentSentAt',
               'managerProposedAt', 'completedAt',
               'pickupCode', 'pickupToken', 'paymentConfirmedAt',
               'paymentIssueNote', 'paymentIssueAt', 'payoutCode'
             ])
          && (
            (
              request.resource.data.status == 'manager_proposed'
              && resource.data.status in ['customer_requested', 'manager_proposed', 'customer_countered']
            )
            // Acceptera kundens motförslag: kundens avgift, samma växelkurs.
            || (
              request.resource.data.status == 'customer_accepted'
              && resource.data.status == 'customer_countered'
              && request.resource.data.feePercent == resource.data.counterFeePercent
              && request.resource.data.rateFromTo == resource.data.rateFromTo
            )
            // Skicka betalningsuppgifter till kunden efter accept (status oförändrad).
            || (
              request.resource.data.status == 'customer_accepted'
              && resource.data.status == 'customer_accepted'
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'chosenPaymentMethodId', 'paymentMethodLabel',
                   'paymentMethodDetails', 'paymentSentAt'
                 ])
            )
            // Genomförd bara i samma batch som kontorets saldo bokförs för
            // just den här transaktionen (se offices-regeln).
            // Bekräfta att betalningen har kommit och skapa uthämtningskoden.
            // Från customer_accepted gäller kunder utan konto (de kan inte
            // själva markera betalt).
            || (
              request.resource.data.status == 'payment_confirmed'
              && resource.data.status in ['customer_accepted', 'customer_paid']
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'status', 'pickupCode', 'pickupToken', 'paymentConfirmedAt'
                 ])
              // ÅÅMMDD-XXXX-XXXX och en hemlig nyckel på 32 tecken för QR-koden.
              && request.resource.data.pickupCode is string
              && request.resource.data.pickupCode.matches('[0-9]{6}-[0-9]{4}-[0-9]{4}')
              && request.resource.data.pickupToken is string
              && request.resource.data.pickupToken.size() == 32
            )
            // Betalningen har inte kommit: tillbaka till kunden med meddelande.
            || (
              request.resource.data.status == 'customer_accepted'
              && resource.data.status == 'customer_paid'
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'status', 'paymentIssueNote', 'paymentIssueAt'
                 ])
            )
            || (
              request.resource.data.status == 'completed'
              && resource.data.status == 'payment_confirmed'
              && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                   'status', 'completedAt', 'payoutCode'
                 ])
              && request.resource.data.payoutCode == resource.data.pickupCode
              && getAfter(/databases/$(database)/documents/offices/$(resource.data.officeId))
                   .data.get('lastBookedTransactionId', '') == docId
            )
          )
        )

        // Kund: acceptera eller avböja ett förslag från managern.
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'manager_proposed'
          && request.resource.data.status in ['customer_accepted', 'customer_rejected']
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['status', 'customerDecisionAt'])
        )

        // Kund: markera som betalt (med ev. kvitto och meddelande) när
        // betalningsuppgifterna har skickats.
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'customer_accepted'
          && resource.data.get('paymentMethodLabel', '') != ''
          && request.resource.data.status == 'customer_paid'
          && request.resource.data.get('paymentNote', '') is string
          && request.resource.data.get('paymentNote', '').size() <= 500
          && (
            !('receiptPath' in request.resource.data)
            || request.resource.data.receiptPath.matches('receipts/' + docId + '/.*')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'customerPaidAt', 'paymentNote', 'receiptPath',
               'receiptName', 'receiptContentType'
             ])
        )

        // Kund: ett enda motförslag med lägre avgift (och ev. meddelande).
        || (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'manager_proposed'
          && resource.data.get('counterOfferUsed', false) != true
          && request.resource.data.status == 'customer_countered'
          && request.resource.data.counterOfferUsed == true
          && request.resource.data.counterFeePercent is number
          && request.resource.data.counterFeePercent >= 0
          && request.resource.data.counterFeePercent < resource.data.feePercent
          && request.resource.data.get('counterMessage', '') is string
          && request.resource.data.get('counterMessage', '').size() <= 500
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'customerDecisionAt', 'counterOfferUsed',
               'counterFeePercent', 'counterMessage'
             ])
        );

      allow delete: if isAdmin();
    }
  }
}
